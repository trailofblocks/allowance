{
  "name": "allowance",
  "version": "0.1.0",
  "description": "Spending limits an AI agent can't talk its way past: an ERC-7579 policy module, a TypeScript SDK and MCP server for agent payments (including x402), and a prompt-injection red-team suite.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "license": "MIT",
  "bin": {
    "allowance": "dist/cli.js"
  },
  "files": [
    "dist",
    "contracts",
    "foundry.toml",
    "out/AllowanceModule.sol",
    "out/AgentAccount.sol",
    "out/MockEIP3009Token.sol",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build:contracts": "forge build",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:contracts": "forge test",
    "test": "tsx --test tests/*.test.ts",
    "lab": "tsx src/cli.ts lab",
    "allowance": "tsx src/cli.ts",
    "build:abi": "forge build && node scripts/gen-abi.mjs",
    "mutation": "node scripts/mutation-check.mjs"
  },
  "keywords": [
    "ai-agent",
    "agent-payments",
    "x402",
    "erc-7579",
    "eip-7702",
    "smart-account",
    "spending-limits",
    "prompt-injection",
    "mcp",
    "solidity",
    "foundry"
  ],
  "dependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/server": "2.4.0",
    "commander": "^15.1.0",
    "viem": "2.58.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@openzeppelin/contracts": "5.6.1",
    "@types/node": "^26.6.6",
    "@x402/core": "2.32.0",
    "@x402/evm": "2.32.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trailofblocks/allowance.git"
  },
  "homepage": "https://github.com/trailofblocks/allowance#readme"
}
